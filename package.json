{
  "name": "@rcarmo/piclaw-addons",
  "version": "2.0.1",
  "description": "Community add-ons for piclaw — extensions, skills, and widgets",
  "keywords": [
    "extensions",
    "pi-package",
    "piclaw",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "sync:catalog": "bun scripts/sync-catalog.ts --write",
    "check:catalog": "bun scripts/sync-catalog.ts --check",
    "typecheck:earendil-compat": "tsc --noEmit -p tsconfig.earendil-compat.json && tsc --noEmit -p addons/m365/tsconfig.json",
    "test:earendil-compat": "bun test addons/cheapskate/index.test.ts addons/codex-conversion/index.test.ts addons/delegate/index.test.ts addons/m365/tests/*.test.ts addons/skill-model-effort/index.test.ts addons/smart-compaction/index.test.ts addons/autoresearch/supervisor.test.ts",
    "addon:e2e": "cd tests/addon-e2e && bun run test -- --project=desktop-chrome",
    "addon:e2e:all": "cd tests/addon-e2e && PICLAW_ADDON=all bun run test -- --project=desktop-chrome",
    "addon:e2e:report": "cd tests/addon-e2e && bun run report"
  },
  "homepage": "https://github.com/rcarmo/piclaw-addons",
  "bugs": {
    "url": "https://github.com/rcarmo/piclaw-addons/issues"
  },
  "pi": {
    "extensions": [
      "addons/ast-grep-tool/index.ts",
      "addons/autoresearch/index.ts",
      "addons/cheapskate/index.ts",
      "addons/code-validator/index.ts",
      "addons/codex-conversion/src/index.ts",
      "addons/delegate/index.ts",
      "addons/dev-tools/index.ts",
      "addons/drawio-editor/index.ts",
      "addons/editable-table/index.ts",
      "addons/eml-viewer/index.ts",
      "addons/ghostty-terminal/index.ts",
      "addons/git-query-tools/index.ts",
      "addons/goal/index.ts",
      "addons/image-processing/index.ts",
      "addons/imap/index.ts",
      "addons/kanban-board-widget/index.ts",
      "addons/kanban-editor/index.ts",
      "addons/late-night-regrets/index.ts",
      "addons/lite-term/index.ts",
      "addons/m365/index.ts",
      "addons/mindmap/index.ts",
      "addons/observability/index.ts",
      "addons/office-tools/index.ts",
      "addons/office-viewer/index.ts",
      "addons/plan-sidebar/index.ts",
      "addons/portainer/index.ts",
      "addons/proxmox/index.ts",
      "addons/remote-peer/index.ts",
      "addons/sample-addon/index.ts",
      "addons/session-dashboard/index.ts",
      "addons/session-tree/index.ts",
      "addons/skill-model-effort/src/index.ts",
      "addons/smart-compaction/index.ts",
      "addons/stealth-browser/index.ts",
      "addons/telegram/index.ts",
      "addons/vent/index.ts",
      "addons/voice-pipeline/index.ts",
      "addons/web-viewer/index.ts",
      "addons/whatsapp/index.ts",
      "addons/win-ui/index.ts",
      "addons/writer-fonts/index.ts",
      "addons/yolo-vibe/index.ts"
    ],
    "runtime": {
      "entries": [
        "addons/autoresearch/runtime.ts",
        "addons/remote-peer/runtime.ts"
      ]
    },
    "skills": [
      "addons/autoresearch/skills",
      "addons/delegate/skills",
      "addons/editable-table/skills",
      "addons/m365/skills",
      "addons/remote-peer/skills",
      "addons/settings-dialog-screenshot/skills",
      "addons/stealth-browser/skills"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "autoresearch-create",
        "path": "./addons/autoresearch/skills/autoresearch-create"
      },
      {
        "name": "delegate",
        "path": "./addons/delegate/skills/delegate"
      },
      {
        "name": "editable-table",
        "path": "./addons/editable-table/skills/editable-table"
      },
      {
        "name": "m365-document-link-metadata",
        "path": "./addons/m365/skills/m365-document-link-metadata"
      },
      {
        "name": "m365-graph-query",
        "path": "./addons/m365/skills/m365-graph-query"
      },
      {
        "name": "m365-mail",
        "path": "./addons/m365/skills/m365-mail"
      },
      {
        "name": "m365-onedrive-share-local-file",
        "path": "./addons/m365/skills/m365-onedrive-share-local-file"
      },
      {
        "name": "m365-profile",
        "path": "./addons/m365/skills/m365-profile"
      },
      {
        "name": "m365-spo-browse",
        "path": "./addons/m365/skills/m365-spo-browse"
      },
      {
        "name": "m365-spo-download",
        "path": "./addons/m365/skills/m365-spo-download"
      },
      {
        "name": "m365-spo-search",
        "path": "./addons/m365/skills/m365-spo-search"
      },
      {
        "name": "m365-teams-chats",
        "path": "./addons/m365/skills/m365-teams-chats"
      },
      {
        "name": "m365-teams-messages",
        "path": "./addons/m365/skills/m365-teams-messages"
      },
      {
        "name": "m365-teams-send",
        "path": "./addons/m365/skills/m365-teams-send"
      },
      {
        "name": "remote-peer",
        "path": "./addons/remote-peer/skills/remote-peer"
      },
      {
        "name": "settings-dialog-screenshot",
        "path": "./addons/settings-dialog-screenshot/skills/settings-dialog-screenshot"
      },
      {
        "name": "stealth-browse",
        "path": "./addons/stealth-browser/skills/stealth-browse"
      }
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcarmo/piclaw-addons.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "addons",
    "catalog.json"
  ],
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "bun-types": "^1.3.13",
    "marked": "^18.0.3",
    "typescript": "7.0.2",
    "@sinclair/typebox": "0.34.52"
  }
}
