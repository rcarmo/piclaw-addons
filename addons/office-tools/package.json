{
  "name": "@rcarmo/piclaw-addon-office-tools",
  "version": "0.1.6",
  "description": "Office document read/write tools for Piclaw (docx, xlsx, pptx, odt, md→pdf)",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=1.8.0",
    "tags": [
      "office",
      "documents",
      "docx",
      "xlsx",
      "pptx",
      "pdf"
    ]
  },
  "dependencies": {
    "fflate": "0.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/office-tools/"
}
