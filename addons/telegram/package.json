{
  "name": "@rcarmo/piclaw-addon-telegram",
  "version": "0.3.1",
  "description": "Telegram Bot channel for PiClaw. Long-polls the Bot API at startup for local notices. Inbound agent access is currently unavailable.",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=3.3.2",
    "tags": [
      "channel",
      "messaging",
      "telegram"
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "runtime": {
      "entries": [
        "runtime.ts"
      ],
      "load": "startup"
    },
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "dependencies": {
    "grammy": "1.46.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi-package",
    "piclaw",
    "piclaw-addon",
    "telegram"
  ],
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/telegram/"
}
