{
  "name": "@rcarmo/piclaw-addon-observability",
  "version": "0.1.25",
  "description": "OpenTelemetry observability — trace errors and agent turns across piclaw instances to Azure Application Insights (with Live Metrics) and local Graphite",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=2.0.0",
    "tags": [
      "observability",
      "tracing",
      "otel",
      "opentelemetry",
      "application-insights",
      "graphite",
      "metrics",
      "live-metrics",
      "core"
    ],
    "skills": [
      "skills/usage-telemetry-chart"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "usage-telemetry-chart",
        "path": "./skills/usage-telemetry-chart"
      }
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "1.21.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.12.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-telemetry": "*"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "pi-package",
    "piclaw",
    "piclaw-addon"
  ],
  "license": "MIT",
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/observability/",
  "peerDependenciesMeta": {
    "@earendil-works/pi-telemetry": {
      "optional": true
    }
  },
  "files": [
    "index.ts",
    "native-telemetry.ts",
    "usage-telemetry.ts",
    "usage-telemetry-job.ts",
    "usage-telemetry-worker.ts",
    "model-speed-telemetry.ts",
    "compaction-telemetry.ts",
    "compat",
    "web/index.ts",
    "web/settings-fields.ts",
    "skills/usage-telemetry-chart/SKILL.md",
    "skills/usage-telemetry-chart/usage-telemetry-chart.ts",
    "assets",
    "azure-app-insights-live-metrics.jpg",
    "README.md"
  ]
}
