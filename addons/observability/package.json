{
  "name": "@rcarmo/piclaw-addon-observability",
  "version": "0.1.11",
  "description": "OpenTelemetry observability — trace errors and agent turns across piclaw instances to Azure Application Insights (with Live Metrics) and local Graphite",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=2.0.0",
    "tags": [
      "observability",
      "tracing",
      "otel",
      "opentelemetry",
      "application-insights",
      "graphite",
      "metrics",
      "live-metrics",
      "core"
    ],
    "skills": [
      "skills/usage-telemetry-chart"
    ]
  },
  "agents": {
    "skills": [
      { "name": "usage-telemetry-chart", "path": "./skills/usage-telemetry-chart" }
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.19",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/resources": "^2.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "pi-package",
    "piclaw",
    "piclaw-addon"
  ],
  "license": "MIT",
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/observability/"
}
