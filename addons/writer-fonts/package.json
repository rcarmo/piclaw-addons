{
  "name": "@rcarmo/piclaw-addon-writer-fonts",
  "version": "0.1.3",
  "description": "Switch the document editor font from a dropdown in the editor footer \u2014 bundles Literata, Inter, Noto Sans, Noto Sans TC, New Tegomin and IBM Plex Sans, plus Georgia and the shipped System stack",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=2.0.0",
    "tags": [
      "editor",
      "fonts",
      "typography",
      "writing",
      "web-ui"
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi-package",
    "piclaw",
    "piclaw-addon",
    "fonts",
    "editor",
    "typography"
  ],
  "license": "MIT",
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/writer-fonts/"
}
