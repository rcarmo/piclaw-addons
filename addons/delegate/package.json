{
  "name": "@rcarmo/piclaw-addon-delegate",
  "version": "0.2.8",
  "description": "Delegate tasks to operator-approved child-Pi models with fail-closed enforcement",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
