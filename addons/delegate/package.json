{
  "name": "@rcarmo/piclaw-addon-delegate",
  "version": "0.2.6",
  "description": "Delegate tasks to verified cheaper/faster child-Pi models with deterministic tier-safe selection",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=1.8.0",
    "tags": [
      "delegation",
      "multi-model",
      "cost-optimization"
    ],
    "skills": [
      "skills/delegate"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "delegate",
        "path": "./skills/delegate"
      }
    ]
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    },
    "skills": [
      "skills"
    ]
  },
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/delegate/"
}
