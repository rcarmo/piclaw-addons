{
  "name": "@rcarmo/piclaw-addon-lite-term",
  "version": "0.1.2",
  "description": "xterm.js terminal pane identical to Piclaw's bundled default terminal and a good starting point for terminal customizations",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=1.8.0",
    "tags": ["terminal", "xterm", "lite", "low-spec", "nerd-font"]
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": ["pi-package", "piclaw", "piclaw-addon", "terminal", "xterm"],
  "pi": {
    "extensions": ["index.ts"],
    "web": {
      "entries": ["web/index.ts"]
    }
  },
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/lite-term/"
}
