{
  "name": "@rcarmo/piclaw-addon-remote-peer",
  "version": "0.3.1",
  "description": "Iroh-only client-ID peer chat with explicit pairing, default-off mDNS, durable delivery and files",
  "type": "module",
  "main": "index.ts",
  "piclaw": {
    "type": "extension",
    "compatibleVersions": ">=3.0.1",
    "tags": [
      "remote",
      "agents",
      "messaging",
      "interop"
    ],
    "skills": [
      "skills/remote-peer"
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "runtime": {
      "entries": [
        "runtime.ts"
      ],
      "load": "startup"
    },
    "web": {
      "entries": [
        "web/index.ts"
      ]
    },
    "skills": [
      "skills"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "remote-peer",
        "path": "./skills/remote-peer"
      }
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi-package",
    "piclaw",
    "piclaw-addon",
    "remote-peer",
    "messaging",
    "interop"
  ],
  "license": "MIT",
  "homepage": "https://rcarmo.github.io/piclaw-addons/addons/remote-peer/",
  "dependencies": {
    "@number0/iroh": "1.1.0",
    "bonjour-service": "1.4.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
