{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "addons/autoresearch/supervisor.ts",
    "addons/cheapskate/*.ts",
    "addons/cheapskate/web/**/*.ts",
    "addons/codex-conversion/**/*.ts",
    "addons/delegate/**/*.ts",
    "addons/skill-model-effort/**/*.ts",
    "addons/smart-compaction/**/*.ts",
    "addons/late-night-regrets/*.ts",
    "addons/late-night-regrets/web/**/*.ts",
    "addons/late-night-regrets/scripts/build-review.ts",
    "addons/late-night-regrets/scripts/setup-nightly-task.ts"
  ],
  "exclude": [
    "node_modules",
    "addons/autoresearch/vendor"
  ]
}
